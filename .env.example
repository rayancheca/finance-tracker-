# Database - Neon Postgres connection string
DATABASE_URL="postgres://user:pass@host/db?sslmode=require"

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""

# Clerk URLs (paths within the app)
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/"

# App config
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Live aggregation (Phase 11.5 — optional for v1) ---
# Plaid
PLAID_CLIENT_ID=""
PLAID_SECRET=""
PLAID_ENV="sandbox"
PLAID_PRODUCTS="transactions,auth,investments,liabilities"
PLAID_COUNTRY_CODES="US"
PLAID_WEBHOOK_URL=""

# SnapTrade
SNAPTRADE_CLIENT_ID=""
SNAPTRADE_CONSUMER_KEY=""
SNAPTRADE_REDIRECT_URI=""

# Token encryption (AES-256-GCM, generate via: openssl rand -base64 32)
ENCRYPTION_KEY=""

# Vercel Cron auth
CRON_SECRET=""
